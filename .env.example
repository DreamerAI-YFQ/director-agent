# === Server ===
PORT=3000

# === Agent runtime ===
# claude_agent: Claude Agent SDK runtime with in-process MCP tools
# legacy: existing Anthropic Messages SDK loop, used as fallback
AGENT_RUNTIME=claude_agent
MODEL=claude-haiku-4-5
CLAUDE_AGENT_MODEL=

# === Anthropic-compatible chat model ===
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_BASE_URL=

# === Gemini video analysis ===
GEMINI_API_KEY=replace_me

# === DashScope / QwenVL / Embeddings ===
DASHSCOPE_API_KEY=replace_me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-flash
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# === PostgreSQL / pgvector ===
PG_HOST=localhost
PG_PORT=5432
PG_DB=ai_director
PG_USER=director
PG_PASSWORD=director123

# === Docker Compose helpers ===
POSTGRES_DB=ai_director
POSTGRES_USER=director
POSTGRES_PASSWORD=director123
ADMINER_PORT=8080
